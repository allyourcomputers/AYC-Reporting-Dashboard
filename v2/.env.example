# ==============================================================================
# HaloPSA Reporting Dashboard - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for development or set these in your deployment
# platform for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite - exposed to browser)
# ------------------------------------------------------------------------------

# Convex deployment URL
# Development: Automatically populated by `npx convex dev`
# Production: Get from Convex Dashboard > Settings > Deployment URL
VITE_CONVEX_URL=https://your-project.convex.cloud

# Clerk publishable key
# Development: Use pk_test_xxx from Clerk Dashboard
# Production: Use pk_live_xxx from Clerk Dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ------------------------------------------------------------------------------
# Convex Backend Configuration (Server-side only - NOT exposed to browser)
# Set these in Convex Dashboard > Settings > Environment Variables
# ------------------------------------------------------------------------------

# Convex deployment name (for CLI)
# Format: "dev:project-name" or "prod:project-name"
CONVEX_DEPLOYMENT=dev:your-project-name

# Clerk JWT issuer domain (for backend auth validation)
# Format: https://your-clerk-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev

# ------------------------------------------------------------------------------
# NinjaOne API Configuration
# Get credentials from NinjaOne Administration > Apps > API
# ------------------------------------------------------------------------------

NINJA_CLIENT_ID=your_ninja_client_id
NINJA_CLIENT_SECRET=your_ninja_client_secret
NINJA_BASE_URL=https://app.ninjarmm.com

# ------------------------------------------------------------------------------
# HaloPSA API Configuration
# Get credentials from HaloPSA Configuration > Integrations > API
# ------------------------------------------------------------------------------

HALO_API_URL=https://your-instance.halopsa.com/api
HALO_CLIENT_ID=your_halo_client_id
HALO_CLIENT_SECRET=your_halo_client_secret

# ------------------------------------------------------------------------------
# 20i API Configuration
# Get API key from 20i Reseller Control Panel > API
# ------------------------------------------------------------------------------

TWENTYI_API_KEY=your_20i_api_key

# ------------------------------------------------------------------------------
# Migration Configuration (only needed for Supabase migration)
# ------------------------------------------------------------------------------

# Supabase credentials (for migration scripts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
