# Production environment variables for Docker deployment
# Copy this to .env and fill in the values

# Convex Production URL
VITE_CONVEX_URL=https://festive-boar-373.convex.cloud

# Port to expose (default: 3200)
PORT=3200

# ==============================================================================
# IMPORTANT: Convex Auth Server-Side Variables
# ==============================================================================
# These must be set in the Convex Dashboard > Settings > Environment Variables
# (NOT in this file - they are server-side only)
#
# AUTH_SECRET        - Generate with: openssl rand -base64 32
# JWT_PRIVATE_KEY    - RSA PKCS#8 private key (see .env.example for generation)
# SITE_URL           - Your production URL (e.g., https://yourdomain.com)
# ==============================================================================
