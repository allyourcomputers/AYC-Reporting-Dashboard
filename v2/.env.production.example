# ==============================================================================
# Production Environment - Docker Build Configuration
# ==============================================================================
# Copy this file to .env on your production server where docker-compose runs.
# These values are used at BUILD TIME by Docker.
# ==============================================================================

# Convex production deployment URL
VITE_CONVEX_URL=https://festive-boar-373.convex.cloud

# Clerk publishable key (must match the Clerk instance in CLERK_JWT_ISSUER_DOMAIN)
# Get from Clerk Dashboard > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_key_here

# Port to expose the app on (default: 3200)
PORT=3200
